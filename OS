#include <stdio.h>

int main() {
    int p[10], bt[10], wt[10], tat[10];
    int n;
    float tatavg = 0, wtavg = 0;

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    printf("Enter the burst time of %d processes:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &bt[i]);
        p[i] = i; // process ID
    }

    // Sort by burst time (Shortest Job First - SJF)
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (bt[j] > bt[j + 1]) {
                // Swap burst times
                int temp = bt[j];
                bt[j] = bt[j + 1];
                bt[j + 1] = temp;

                // Swap process IDs
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    // Waiting time
    wt[0] = 0;
    for (int i = 1; i < n; i++) {
        wt[i] = wt[i - 1] + bt[i - 1];
    }

    // Turnaround time
    for (int i = 0; i < n; i++) {
        tat[i] = wt[i] + bt[i];
        wtavg += wt[i];
        tatavg += tat[i];
    }

    // Output
    for (int i = 0; i < n; i++) {
        printf("Process %d: Burst Time = %d, Waiting Time = %d, Turnaround Time = %d\n",
               p[i], bt[i], wt[i], tat[i]);
    }

    printf("Average Waiting Time = %.2f\n", wtavg / n);
    printf("Average Turnaround Time = %.2f\n", tatavg / n);

    return 0;
}






